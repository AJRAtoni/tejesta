{{ 'tejesta-contact-page.css' | asset_url | stylesheet_tag }}

<section
  class="tejesta-contact color-{{ section.settings.color_scheme }} gradient"
  style="--tejesta-contact-min-height: {{ section.settings.desktop_min_height }}px;"
>
  <div class="tejesta-contact__inner">
    <div class="tejesta-contact__intro{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      <h1 class="tejesta-contact__heading">{{ section.settings.heading | escape }}</h1>

      {%- if section.settings.intro_text != blank -%}
        <div class="tejesta-contact__intro-text rte">
          {{ section.settings.intro_text }}
        </div>
      {%- endif -%}
    </div>

    <div class="tejesta-contact__divider" aria-hidden="true">
      <img
        class="tejesta-contact__divider-image"
        src="{{ 'tejesta-line-art-divider.png' | asset_url }}"
        width="5389"
        height="127"
        loading="lazy"
        alt=""
      >
    </div>

    <div class="tejesta-contact__form-panel{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- form 'contact', id: 'TejestaContactForm', class: 'tejesta-contact__form' -%}
        {%- if form.posted_successfully? -%}
          <div class="tejesta-contact__status tejesta-contact__status--success" tabindex="-1" autofocus>
            <span class="svg-wrapper">
              {{- 'icon-success.svg' | inline_asset_content -}}
            </span>
            <p>{{ 'templates.contact.form.post_success' | t }}</p>
          </div>
        {%- elsif form.errors -%}
          <div class="tejesta-contact__status tejesta-contact__status--error" role="alert" tabindex="-1" autofocus>
            <span class="svg-wrapper">
              {{- 'icon-error.svg' | inline_asset_content -}}
            </span>
            <div>
              <p>{{ 'templates.contact.form.error_heading' | t }}</p>
              <a href="#TejestaContactForm-email" class="link">
                {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
              </a>
            </div>
          </div>
        {%- endif -%}

        <div class="tejesta-contact__field tejesta-contact__field--name">
          <label class="visually-hidden" for="TejestaContactForm-name">
            {{- section.settings.name_label | escape -}}
          </label>
          <input
            id="TejestaContactForm-name"
            type="text"
            name="contact[{{ 'templates.contact.form.name' | t }}]"
            autocomplete="name"
            placeholder="{{ section.settings.name_label | escape }}"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
          >
        </div>

        <div class="tejesta-contact__field">
          <label class="visually-hidden" for="TejestaContactForm-email">
            {{- section.settings.email_label | escape -}}
          </label>
          <input
            id="TejestaContactForm-email"
            type="email"
            name="contact[email]"
            autocomplete="email"
            spellcheck="false"
            autocapitalize="off"
            placeholder="{{ section.settings.email_label | escape }}"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            aria-required="true"
            required
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="TejestaContactForm-email-error"
            {% endif %}
          >
          {%- if form.errors contains 'email' -%}
            <small class="tejesta-contact__field-error" id="TejestaContactForm-email-error">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </small>
          {%- endif -%}
        </div>

        <div class="tejesta-contact__field tejesta-contact__field--message">
          <label for="TejestaContactForm-body">{{ section.settings.message_label | escape }}</label>
          <textarea
            id="TejestaContactForm-body"
            name="contact[{{ 'templates.contact.form.comment' | t }}]"
            rows="10"
          >{{- form.body -}}</textarea>
        </div>

        <div class="tejesta-contact__button">
          <button type="submit" class="button button--tejesta-frame">
            {{ section.settings.button_label | escape }}
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TEJESTA contact page",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact Us"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Introductory text",
      "default": "<p>Please don't hesitate to get in touch with us if you have any questions. Our team is happy to help and we try our best to respond to emails within 24 hours.</p>"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name placeholder",
      "default": "Name"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email placeholder",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message field label",
      "default": "How can we help?"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Send"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "desktop_min_height",
      "min": 640,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "label": "Minimum height on desktop",
      "default": 900
    }
  ],
  "presets": [
    {
      "name": "TEJESTA contact page"
    }
  ]
}
{% endschema %}
